{
  "schemaVersion": "mcp-server-card/draft-2026-10",
  "protocolVersion": "2026-07-28",
  "serverInfo": {
    "name": "io.github.torutesu/shogunagent",
    "title": "ShogunAgent",
    "version": "0.1.0"
  },
  "description": "The state layer for AI agents. Read what is true about the user's work right now (people, projects, commitments, open loops) with a quote and a confidence score on every fact; write what you learned so the next agent starts from it; run tools through a router that enforces permission tiers. Not a transcript store and not a general web-search tool.",
  "transport": {
    "type": "streamable-http",
    "url": "https://api.test/mcp",
    "headers": [
      "Mcp-Method",
      "Mcp-Name",
      "Mcp-Quantity",
      "Mcp-Dry-Run"
    ]
  },
  "authentication": {
    "anonymous": {
      "allowed": true,
      "scope": "router.discover, router.inspect and narrow reads"
    },
    "schemes": [
      {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "sa_live_<key>",
        "scopes": [
          "read",
          "write",
          "run"
        ],
        "registration": {
          "url": "https://api.test/v1/agents",
          "method": "POST",
          "description": "Self-registration: a proof-of-work challenge, no email; returns a scoped key and the free allowance."
        }
      }
    ]
  },
  "capabilities": {
    "tools": {
      "listChanged": false
    }
  },
  "toolset": "core",
  "tools": [
    {
      "name": "memory.search",
      "title": "Search memory",
      "description": "Find events and notes in the user's memory by keyword. Free. Not for extracting state: use state.* for people, projects, commitments and open loops.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        },
        "required": [
          "query"
        ]
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "x-shogunagent": {
        "level": "read",
        "cost_unit": "read"
      }
    },
    {
      "name": "memory.get_context",
      "title": "Get current context",
      "description": "The user's current work context (focused app, recent events). Free. Prefer memory.get_context_pack for a prompt-ready summary.",
      "inputSchema": {
        "type": "object",
        "properties": {}
