# deploy/compose/.env — copy to .env, fill in, keep it out of version control (0600).
# Every variable is described in deploy/README.md. Values here are placeholders, not working keys.

# --- Release and region --------------------------------------------------------------------------
SHOGUN_VERSION=0.1.0
# The region this host serves. One host (or fleet) per region; nothing crosses regions.
SHOGUN_REGION=ap-northeast-1
# Where the gateway port is published on the host (put a TLS-terminating proxy in front).
GATEWAY_BIND=127.0.0.1
GATEWAY_PORT=8787

# --- Postgres (gateway ledger) -------------------------------------------------------------------
POSTGRES_PASSWORD=change-me-postgres-superuser
GATEWAY_DB_PASSWORD=change-me-gateway-role

# --- Gateway (apps/api/src/boot.ts) --------------------------------------------------------------
# Your own provider key: model calls go from this host straight to the provider.
OPENAI_API_KEY=sk-replace-me
ANTHROPIC_API_KEY=
BATCH_PROVIDER=openai
# base64 of the licence API's 32-byte Ed25519 public key (packages/config/license-public-key.json).
LICENSE_PUBKEY_B64=replace-with-base64-public-key
# Global daily spend breaker, USD per UTC day.
DAILY_SPEND_CAP_USD=50
AGENT_API_ENABLED=0
AGENT_POW_SECRET=
PUBLIC_BASE_URL=
METRICS_TOKEN=
# Approvals (E15): the same signing key on the sidecar and the gateway (>= 32 characters), and the
# webhook signing secret the gateway requires once the signing key is set.
SHOGUN_APPROVAL_SIGNING_KEY=
WEBHOOK_SIGNING_SECRET=
SHOGUN_APPROVAL_BASE_URL=

# --- Sidecar ------------------------------------------------------------------------------------
# The gateway's derived bearers (E34): >= 32 characters, the same value as the gateway's
# SHOGUN_SIDECAR_BEARER_SECRET. With it, SHOGUN_PRINCIPAL_TOKENS can stay empty (threat model R4).
SHOGUN_SIDECAR_BEARER_SECRET=
# principal:token[:agent_id],... : a fixed list (BYOC, evaluation). A listed token wins.
SHOGUN_PRINCIPAL_TOKENS=
SHOGUN_ADMIN_TOKEN=
SHOGUN_MULTI_MAX_OPEN=64

# Key provider: env | aws-kms | gcp-kms | vault. `env` is for evaluation only.
SHOGUN_KEY_PROVIDER=vault
SHOGUN_KMS_KEY_CACHE_SECS=300
SHOGUN_KMS_TIMEOUT_SECS=10

# aws-kms (static credentials on a plain host; on EKS use IRSA through the Helm chart)
SHOGUN_AWS_KMS_KEY_ID=
SHOGUN_AWS_KMS_REGION=
SHOGUN_AWS_KMS_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# gcp-kms (a token file refreshed by your token agent, mounted into the sidecar)
SHOGUN_GCP_KMS_KEY=
SHOGUN_GCP_ACCESS_TOKEN_FILE=

# vault (Transit; https only)
VAULT_ADDR=https://vault.internal:8200
VAULT_NAMESPACE=
VAULT_TOKEN=
SHOGUN_VAULT_TRANSIT_MOUNT=transit
SHOGUN_VAULT_TRANSIT_KEY=shogunagent-principals

# env provider only (64 hex characters). Leave empty with a KMS provider.
SHOGUN_DB_KEY=
