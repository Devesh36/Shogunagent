{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shogunagent.dev/schemas/export-v1.schema.json",
  "title": "ShogunAgent export v1 record",
  "description": "One line of a ShogunAgent export (JSON Lines). The first line is a manifest; every other line is an entity, a fact or a tombstone. See docs/api/export-v1.md.",
  "oneOf": [
    { "$ref": "#/$defs/manifest" },
    { "$ref": "#/$defs/entity" },
    { "$ref": "#/$defs/fact" },
    { "$ref": "#/$defs/tombstone" }
  ],
  "$defs": {
    "ms": { "type": "integer", "description": "Unix time in milliseconds" },
    "msOrNull": { "type": ["integer", "null"] },
    "intOrNull": { "type": ["integer", "null"] },
    "stringOrNull": { "type": ["string", "null"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "band": { "type": "string", "enum": ["high", "medium", "low"] },
    "namespace": { "type": "string", "pattern": "^(world|agent_scratch:.+)$" },
    "provenance": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["event_id", "quote"],
        "properties": {
          "event_id": { "type": "integer" },
          "quote": { "$ref": "#/$defs/stringOrNull" }
        }
      }
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "format", "schema_version", "generated_at", "since_cursor", "cursor", "counts"],
      "properties": {
        "type": { "const": "manifest" },
        "format": { "const": "shogunagent-export/v1" },
        "schema_version": { "type": "integer", "minimum": 1 },
        "generated_at": { "$ref": "#/$defs/ms" },
        "since_cursor": { "$ref": "#/$defs/msOrNull" },
        "cursor": { "$ref": "#/$defs/ms" },
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["entities", "facts", "tombstones"],
          "properties": {
            "entities": { "type": "integer", "minimum": 0 },
            "facts": { "type": "integer", "minimum": 0 },
            "tombstones": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "kind", "id", "name", "aliases", "summary", "status", "confidence", "band", "valid_from", "valid_to", "updated_at", "actor", "namespace", "provenance"],
      "properties": {
        "type": { "const": "entity" },
        "kind": { "type": "string", "enum": ["person", "project"] },
        "id": { "type": "integer" },
        "name": { "type": "string", "minLength": 1 },
        "aliases": { "type": "array", "items": { "type": "string" } },
        "summary": { "$ref": "#/$defs/stringOrNull" },
        "status": { "type": ["string", "null"], "enum": ["active", "waiting", "paused", "done", null] },
        "confidence": { "$ref": "#/$defs/confidence" },
        "band": { "$ref": "#/$defs/band" },
        "valid_from": { "$ref": "#/$defs/ms" },
        "valid_to": { "$ref": "#/$defs/msOrNull" },
        "updated_at": { "$ref": "#/$defs/ms" },
        "actor": { "$ref": "#/$defs/stringOrNull" },
        "namespace": { "$ref": "#/$defs/namespace" },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "kind", "id", "subtype", "text", "status", "due_at", "counterparty_id", "project_id", "confidence", "band", "valid_from", "valid_to", "updated_at", "actor", "namespace", "provenance"],
      "properties": {
        "type": { "const": "fact" },
        "kind": { "type": "string", "enum": ["commitment", "open_loop"] },
        "id": { "type": "integer" },
        "subtype": { "type": "string", "enum": ["mine", "theirs", "reply_needed", "waiting_on_them", "review_pending", "decision_pending", "follow_up", "other"] },
        "text": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "enum": ["open", "done", "overdue", "cancelled", "closed"] },
        "due_at": { "$ref": "#/$defs/msOrNull" },
        "counterparty_id": { "$ref": "#/$defs/intOrNull" },
        "project_id": { "$ref": "#/$defs/intOrNull" },
        "confidence": { "$ref": "#/$defs/confidence" },
        "band": { "$ref": "#/$defs/band" },
        "valid_from": { "$ref": "#/$defs/ms" },
        "valid_to": { "$ref": "#/$defs/msOrNull" },
        "updated_at": { "$ref": "#/$defs/ms" },
        "actor": { "$ref": "#/$defs/stringOrNull" },
        "namespace": { "$ref": "#/$defs/namespace" },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "tombstone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "kind", "id", "deleted_at", "reason"],
      "properties": {
        "type": { "const": "tombstone" },
        "kind": { "type": "string", "minLength": 1 },
        "id": { "type": "integer" },
        "deleted_at": { "$ref": "#/$defs/ms" },
        "reason": { "type": "string" }
      }
    }
  }
}
